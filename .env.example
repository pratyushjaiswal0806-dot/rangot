# Shared diya counter (Upstash Redis REST). Without these, /api/diyas returns 503
# and the site falls back to the local-only counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The same store powers share links (/r/<id>), greetings, "light a diya back" and Pulli stats.
# Without it those return 503 and the site falls back to plain image sharing.

# Absolute site URL for OG image links, e.g. https://rangotsav.example. Optional on Vercel
# (VERCEL_PROJECT_PRODUCTION_URL is used).
NEXT_PUBLIC_SITE_URL=
